uniform shader backdrop;
uniform float2 resolution;
uniform float time;
uniform float2 tilt;
uniform float thickness;
uniform float refractionStrength;
uniform float blurAmount;
uniform float tintOpacity;
uniform float edgeGlow;
uniform float chromaticAberration;
uniform float viscosity;
uniform float bubbleDensity;
uniform float shapeType;     // 0=Squircle, 1=Blob, 2=Pill, 3=Sharp, 4=Freeform
uniform float4 tintColor;    // RGBA primary glass tint
uniform float4 accentColor;  // RGBA secondary caustic/rim tint
uniform float2 rippleCenter; // Normalized [0..1]
uniform float rippleProgress;// 0..1 (0 = inactive)

float sdRoundedBox(float2 p, float2 b, float r) {
    float2 q = abs(p) - b + float2(r);
    return min(max(q.x, q.y), 0.0) + length(max(q, 0.0)) - r;
}

float sdSquircle(float2 p, float2 b, float power) {
    float2 q = abs(p) / max(b, float2(0.001));
    float d = pow(pow(q.x, power) + pow(q.y, power), 1.0 / power) - 1.0;
    return d * min(b.x, b.y);
}

float shapeSdf(float2 p, float2 halfSize, float t) {
    if (shapeType < 0.5) {
        // Squircle
        return sdSquircle(p, halfSize * 0.96, 4.4);
    } else if (shapeType < 1.5) {
        // Organic morphing blob
        float angle = atan(p.y, p.x);
        float wobble = sin(angle * 3.0 + t * 0.9) * 0.045
                     + cos(angle * 5.0 - t * 0.65) * 0.025;
        float2 morphed = halfSize * (0.93 + wobble);
        return sdSquircle(p, morphed, 3.0);
    } else if (shapeType < 2.5) {
        // Pill
        float r = min(halfSize.x, halfSize.y) * 0.96;
        return sdRoundedBox(p, halfSize * 0.96, r);
    } else if (shapeType < 3.5) {
        // Sharp Glass
        return sdRoundedBox(p, halfSize * 0.97, min(halfSize.x, halfSize.y) * 0.12);
    } else {
        // Freeform droplet-squircle hybrid
        float angle = atan(p.y, p.x);
        float wave = sin(angle * 2.0 + t * 0.5) * 0.03 + cos(angle * 4.0 + t * 0.8) * 0.02;
        return sdRoundedBox(p, halfSize * (0.95 + wave), min(halfSize.x, halfSize.y) * 0.38);
    }
}

float2 calcNormal(float2 p, float2 halfSize, float t) {
    float eps = 1.5;
    float dx = shapeSdf(p + float2(eps, 0.0), halfSize, t) - shapeSdf(p - float2(eps, 0.0), halfSize, t);
    float dy = shapeSdf(p + float2(0.0, eps), halfSize, t) - shapeSdf(p - float2(0.0, eps), halfSize, t);
    return normalize(float2(dx, dy) + float2(0.0001));
}

float metaballField(float2 uv, float t) {
    float field = 0.0;
    float speed = max(0.15, viscosity);
    for (int i = 0; i < 5; i++) {
        float fi = float(i);
        float2 center = float2(
            0.5 + 0.30 * sin(t * speed * (0.45 + fi * 0.13) + fi * 1.7),
            0.5 + 0.28 * cos(t * speed * (0.38 + fi * 0.11) + fi * 2.3)
        );
        float radius = 0.075 + 0.022 * sin(t * 0.7 + fi);
        float d = length(uv - center) + 0.001;
        field += (radius * radius) / (d * d);
    }
    return field;
}

half4 sampleBlurred(float2 coord, float radius) {
    if (radius <= 0.25) {
        return backdrop.eval(clamp(coord, float2(0.0), resolution - float2(1.0)));
    }
    half4 acc = half4(0.0);
    float2 r = float2(radius);
    acc += backdrop.eval(clamp(coord, float2(0.0), resolution - float2(1.0))) * 0.32;
    acc += backdrop.eval(clamp(coord + float2( r.x,  0.0), float2(0.0), resolution - float2(1.0))) * 0.12;
    acc += backdrop.eval(clamp(coord + float2(-r.x,  0.0), float2(0.0), resolution - float2(1.0))) * 0.12;
    acc += backdrop.eval(clamp(coord + float2( 0.0,  r.y), float2(0.0), resolution - float2(1.0))) * 0.12;
    acc += backdrop.eval(clamp(coord + float2( 0.0, -r.y), float2(0.0), resolution - float2(1.0))) * 0.12;
    acc += backdrop.eval(clamp(coord + float2( r.x,  r.y) * 0.7, float2(0.0), resolution - float2(1.0))) * 0.05;
    acc += backdrop.eval(clamp(coord + float2(-r.x,  r.y) * 0.7, float2(0.0), resolution - float2(1.0))) * 0.05;
    acc += backdrop.eval(clamp(coord + float2( r.x, -r.y) * 0.7, float2(0.0), resolution - float2(1.0))) * 0.05;
    acc += backdrop.eval(clamp(coord + float2(-r.x, -r.y) * 0.7, float2(0.0), resolution - float2(1.0))) * 0.05;
    return acc;
}

half4 main(float2 fragCoord) {
    float2 halfSize = resolution * 0.5;
    float2 p = fragCoord - halfSize;
    float2 uv = fragCoord / max(resolution, float2(1.0));

    float sdf = shapeSdf(p, halfSize, time);
    float aa = smoothstep(1.5, -1.5, sdf);
    if (aa <= 0.001) {
        return half4(0.0);
    }

    float minDim = min(halfSize.x, halfSize.y);
    float edgeDist = clamp(-sdf / max(minDim * (0.28 + thickness * 0.34), 1.0), 0.0, 1.0);
    // Curved edges bend strongly (1 - edgeDist)^2.4, flat center bends very little
    float rimFactor = pow(1.0 - edgeDist, 2.4);
    float2 normal = calcNormal(p, halfSize, time);

    // Internal metaball lens pockets
    float meta = metaballField(uv, time) * clamp(bubbleDensity, 0.0, 1.5);
    float metaLens = smoothstep(0.65, 1.45, meta) * 0.18;

    // Touch ripple wave displacement
    float rippleWave = 0.0;
    float2 rippleDir = float2(0.0);
    if (rippleProgress > 0.001 && rippleProgress < 0.999) {
        float2 toTap = uv - rippleCenter;
        float distTap = length(toTap) + 0.0001;
        float waveRadius = rippleProgress * 1.15;
        float ring = exp(-pow((distTap - waveRadius) * 14.0, 2.0));
        float decay = (1.0 - rippleProgress);
        rippleWave = sin((distTap - waveRadius) * 42.0) * ring * decay * 18.0;
        rippleDir = toTap / distTap;
    }

    // Surface liquid micro-wave
    float waveX = sin(uv.y * 12.0 + time * viscosity * 1.3) * 1.4;
    float waveY = cos(uv.x * 10.0 - time * viscosity * 1.1) * 1.4;

    // True refraction offset (bends & magnifies wallpaper at curved rim)
    float refractPx = (rimFactor * 34.0 * refractionStrength * (0.55 + thickness * 0.75))
                    + (metaLens * 14.0 * refractionStrength);
    float2 refractOffset = -normal * refractPx
                         + rippleDir * rippleWave
                         + float2(waveX, waveY) * (0.4 + rimFactor * 0.9);

    float2 sampleBase = fragCoord + refractOffset;

    // Chromatic aberration (RGB dispersion stronger on curved rim & ripple)
    float caPx = chromaticAberration * (2.0 + rimFactor * 7.5 + abs(rippleWave) * 0.25);
    float blurPx = blurAmount * (1.2 + edgeDist * 3.5);

    half4 colR = sampleBlurred(sampleBase + normal * caPx, blurPx);
    half4 colG = sampleBlurred(sampleBase, blurPx);
    half4 colB = sampleBlurred(sampleBase - normal * caPx, blurPx);
    half3 refracted = half3(colR.r, colG.g, colB.b);

    // Subtle glass magnification contrast & depth absorption
    refracted = mix(refracted, refracted * half3(0.92, 0.98, 1.04), half(0.18 + thickness * 0.22));

    // Apply adaptive glass tint
    half3 tinted = mix(refracted, half3(tintColor.rgb), half(clamp(tintOpacity, 0.04, 0.75)));

    // Internal metaball caustic shimmer
    tinted += half3(accentColor.rgb) * half(metaLens * 0.35);

    // Dynamic gyroscope-driven specular highlight (top-left light source shifted by phone tilt)
    float2 lightDir = normalize(float2(-0.68 + tilt.x * 0.55, -0.73 + tilt.y * 0.55));
    float specAlign = max(dot(-normal, lightDir), 0.0);
    float specular = pow(specAlign, 6.0) * rimFactor * (0.72 + edgeGlow * 0.55);

    // Secondary crisp glass edge sheen
    float crispRim = smoothstep(0.06, 0.0, edgeDist) * (0.28 + edgeGlow * 0.65);
    float rimDirectional = smoothstep(-0.2, 0.9, dot(-normal, lightDir));
    float brightRim = crispRim * (0.35 + 0.65 * rimDirectional);

    // Opposite-side inner depth shadow (bottom-right thickness shadow)
    float innerShadow = smoothstep(0.28, 0.0, edgeDist) * max(dot(normal, lightDir), 0.0) * (0.28 + thickness * 0.24);

    // Touch ripple highlight ring
    float rippleSpec = abs(rippleWave) * 0.025;

    half3 finalRgb = tinted
                   + half3(1.0, 1.0, 1.0) * half(specular + brightRim * 0.75 + rippleSpec)
                   + half3(accentColor.rgb) * half(brightRim * 0.40)
                   - half3(0.05, 0.08, 0.14) * half(innerShadow);

    finalRgb = clamp(finalRgb, half3(0.0), half3(1.0));
    return half4(finalRgb, half(aa));
}
